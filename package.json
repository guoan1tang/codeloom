    "mcp",
    "tree-sitter",
    "code-intelligence",
    "impact-analysis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guoan1tang/codeloom.git"
  },
  "homepage": "https://github.com/guoan1tang/codeloom#readme",
